# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
*.iml

# Flutter / Dart (also covered under app/)
**/doc/api/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/build/

# Secrets — never commit real keys
**/env/*.json
!**/env/*.json.example
.env
.env.*

# Android local
**/local.properties
**/key.properties
**/*.jks
**/*.keystore

# Optional local LLM proxy runtime
tool/llm_proxy/.cache/
